# ======================= DocSync: engine settings =======================
# Copy to .env. The demo works out of the box with mock Confluence and no LLM.

# --- git mode: local (repositories on disk, demo) | gitlab (clone and MRs through the API)
DOCSYNC_GIT_MODE=local
DOCSYNC_MODEL_REPO=./data/repos/architecture-model
DOCSYNC_SERVICE_REPOS=payments/orders-service=./data/repos/orders-service
DOCSYNC_MODEL_BRANCH=main

# --- GitLab (for DOCSYNC_GIT_MODE=gitlab)
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=
GITLAB_MODEL_PROJECT=arch/architecture-model
GITLAB_WEBHOOK_SECRET=demo-secret

# --- Confluence: mock (files in data/confluence-mock, viewer at http://localhost:8088/mock-confluence/) | cloud
CONFLUENCE_MODE=mock
CONFLUENCE_URL=https://your-site.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE=SA
CONFLUENCE_PARENT_PAGE_ID=
# attachment - SVG attachments (works everywhere) | macro - PlantUML source inside the plugin macro (sequence only)
DOCSYNC_DIAGRAM_MODE=attachment
CONFLUENCE_PLANTUML_MACRO=plantuml
# true - never write to Confluence, report only (recommended for the first run against cloud)
DOCSYNC_DRY_RUN=false

# --- C4 diagrams: svg (Kroki renders, SVG attached to the page) | structurizr (live diagrams from a Structurizr server)
DOCSYNC_C4_MODE=svg
# Structurizr server (for DOCSYNC_C4_MODE=structurizr). URL must be reachable (https) from readers' browsers.
STRUCTURIZR_URL=http://localhost:18081
# URL the engine pushes to (inside docker compose: http://structurizr:8080/api); default <STRUCTURIZR_URL>/api
STRUCTURIZR_API_URL=
# workspace credentials: `docsync structurizr init` creates a workspace through the admin API and prints them
STRUCTURIZR_WORKSPACE_ID=
STRUCTURIZR_API_KEY=
STRUCTURIZR_API_SECRET=
# admin API key (plain value; the server stores its bcrypt hash in structurizr.properties)
STRUCTURIZR_ADMIN_KEY=
# structurizr-cli: path to structurizr.sh (engine image: /opt/structurizr-cli/structurizr.sh) or `docker` (run structurizr/cli image)
STRUCTURIZR_CLI=docker
DOCSYNC_C4_IFRAME_HEIGHT=650

# --- diagram rendering (Structurizr DSL + PlantUML -> SVG)
KROKI_URL=http://localhost:8000

# --- LLM: none | anthropic | openai-compatible (corporate gateway)
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
LLM_BASE_URL=

# --- notifications (the engine fans out what n8n posts to /api/v1/notify)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# comma-separated usernames or user ids allowed to press Approve/Reject (empty = anyone in the chat)
TELEGRAM_ALLOWED_USERS=
TELEGRAM_POLLING=true

# --- engine API
DOCSYNC_API_TOKEN=
DOCSYNC_PUBLIC_URL=http://localhost:8088
# "approve" link in notifications ({runId} is substituted); defaults to the n8n approve webhook
DOCSYNC_APPROVE_URL=http://localhost:5678/webhook/docsync/approve?run={runId}
DOCSYNC_DATA_DIR=./data
