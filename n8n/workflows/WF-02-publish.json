        },
        "options": {
          "timeout": 600000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_id: $('Notify: published').item.json.runId }) }}"
      },
      "id": "5b26bfeb-c8f0-5eca-b029-1cb0770e1565",
      "name": "Engine: audit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        340
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const a = $input.first().json || {};\nif (a.status !== 'DONE') return [];\nconst open = (a.findings || []).filter(f => f.resolution === 'open');\nconst rest = (a.findings || []).length - open.length;\nconst text = open.length ? `DocSync audit: ${open.length} inline comment(s) on stale hand-written text\\n` + open.map(f => `• ${f.reason}`).join('\\n')\n                         : `DocSync audit: hand-written sections look consistent (${rest} low-confidence finding(s) kept in the report)`;\nreturn [{ json: { text, pagesChecked: a.pagesChecked } }];"
      },
      "id": "ebe84bae-1942-5f09-831d-1361314ceedb",
      "name": "Summarize audit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        340
      ]
    },
