{
  "id": "docsync-wf-02",
  "name": "DocSync 02 · Publish (model merge / approve → Confluence)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "docsync/model",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "20549f04-7838-50f6-ba0b-da1db2f4f8dd",
      "name": "GitLab model webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        200
      ],
      "webhookId": "0e89243f-73c6-5fd6-abea-2563e9b46d70"
    },
    {
      "parameters": {
        "jsCode": "// GitLab secret check and event filtering. Requires N8N_BLOCK_ENV_ACCESS_IN_NODE=false.\nconst item = $input.first().json;\nconst token = (item.headers || {})['x-gitlab-token'] || '';\nif ($env.GITLAB_WEBHOOK_SECRET && token !== $env.GITLAB_WEBHOOK_SECRET) {\n  throw new Error('DocSync: invalid X-Gitlab-Token');\n}\nconst body = item.body || {};\nconst kind = body.object_kind;\nconst a = body.object_attributes || {};\nif (kind === 'merge_request' && a.action !== 'merge') return [];\nif (kind === 'push' && body.ref !== `refs/heads/${(body.project || {}).default_branch || 'main'}`) return [];\nif (!['merge_request', 'push'].includes(kind)) return [];\nreturn [{ json: body }];"
      },
      "id": "e876bc1f-9f6a-5b69-a7b9-c34619652816",
      "name": "Verify model event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DOCSYNC_ENGINE_URL }}/api/v1/publish",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-DocSync-Token",
              "value": "={{ $env.DOCSYNC_API_TOKEN || '' }}"
            }
          ]
        },
        "options": {
          "timeout": 600000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "id": "9ab7e7e0-32a2-57c9-80b6-d811c7a210a0",
      "name": "Engine: publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// input: publish report (from Engine: publish or Unwrap publish)\nconst pub = $input.first().json || {};\nif (pub.noop) return [{ json: { text: pub.text, runId: null } }];\nconst pages = (pub.pages || []).map(p => `${p.status} ${p.title}${p.url ? ' ' + p.url : ''}`).join('\\n');\nconst conflicts = (pub.conflicts || []).map(c => ` ${c.title}: block ${c.blockId} ${c.status}`).join('\\n');\nreturn [{ json: { ...pub, text: `DocSync published architecture-model@${(pub.modelSha||'').slice(0,8)}${pub.dryRun ? ' (DRY RUN)' : ''}\\n${pages}${conflicts ? '\\n' + conflicts : ''}` } }];"
      },
      "id": "d08476e1-6574-503b-888e-270e445859ab",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "docsync/approve",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "ec2ae97c-568e-5318-a6ef-f7c3114bdfbd",
      "name": "Approve webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        480
      ],
      "webhookId": "ab2bf922-2b7d-5a08-aa32-46c61414895a"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DOCSYNC_ENGINE_URL }}/api/v1/runs/{{ $json.query.run }}/approve",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-DocSync-Token",
              "value": "={{ $env.DOCSYNC_API_TOKEN || '' }}"
            }
          ]
        },
        "options": {
          "timeout": 600000
        }
      },
      "id": "fbbf9bf3-8e3a-5d90-a6f2-7c186cb09ef7",
      "name": "Engine: approve",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r.publish) return [{ json: { noop: true, text: `ℹ ${r.status}: run is already ${r.run?.status}`, pages: [], conflicts: [] } }];\nreturn [{ json: r.publish }];"
      },
      "id": "c6a6d128-f144-5ac3-a1a5-c9fbecba4dbb",
      "name": "Unwrap publish",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "// input: publish report (from Engine: publish or Unwrap publish)\nconst pub = $input.first().json || {};\nif (pub.noop) return [{ json: { text: pub.text, runId: null } }];\nconst pages = (pub.pages || []).map(p => `${p.status} ${p.title}${p.url ? ' ' + p.url : ''}`).join('\\n');\nconst conflicts = (pub.conflicts || []).map(c => ` ${c.title}: block ${c.blockId} ${c.status}`).join('\\n');\nreturn [{ json: { ...pub, text: `DocSync published architecture-model@${(pub.modelSha||'').slice(0,8)}${pub.dryRun ? ' (DRY RUN)' : ''}\\n${pages}${conflicts ? '\\n' + conflicts : ''}` } }];"
      },
      "id": "51c83122-4e92-548b-901d-9c88a72b21ae",
      "name": "Summarize (approve)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
